{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Strict mode is mandatory for this project. Do not weaken these to silence
    // errors — fix the code instead (see docs/phase-0-audit.md, working rule 5).
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    // Needed only because packages/shared-types is consumed as TypeScript source
    // and its internal imports carry explicit `.ts` extensions — which Node's
    // native type stripping requires to run that package's own tests. This app
    // emits nothing (`tsc --noEmit`), so the flag changes no output.
    "allowImportingTsExtensions": true,

    // Absolute imports. `@/` maps to src/, so route files under app/ never need
    // to walk back up the tree with ../../.
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "ios", "android", ".expo", "coverage"]
}
