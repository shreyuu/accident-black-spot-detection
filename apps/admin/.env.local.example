# Admin dashboard configuration. Copy to apps/admin/.env.local
#
# The emulator defaults work as-is. Note that FIREBASE_AUTH_EMULATOR_HOST and
# FIRESTORE_EMULATOR_HOST are read by the Admin SDK itself — their presence is
# what points the privileged SDK at the emulators instead of a real project, and
# src/lib/env.ts refuses a configuration that sets only one of them.

FIREBASE_PROJECT_ID=demo-accident-black-spot-detection
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Dashboard session lifetime, in seconds. Bounded to 12 hours.
ADMIN_SESSION_MAX_AGE_SECONDS=3600

# Client config for the sign-in form. Public by design — these are inlined into
# the browser bundle, exactly as the mobile app's EXPO_PUBLIC_* values are.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-accident-black-spot-detection.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-accident-black-spot-detection
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demoappid
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Real project only. Never set alongside the emulator hosts above.
# FIREBASE_SERVICE_ACCOUNT_JSON=
