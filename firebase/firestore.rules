rules_version = '2';

// =============================================================================
// Firestore security rules
// =============================================================================
// Scope: Phase 2 covers the `users` collection only. Collections introduced by
// later phases (blackSpots, incidentReports, emergencyContacts, alertLogs,
// adminAuditLogs, …) are added by the phase that creates them, and the complete
// hardened rule set is reviewed in Phase 12.
//
// Default posture is deny-all. A collection is unreachable until a rule below
// explicitly grants access, so forgetting to write a rule fails closed.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Roles (Phase 7)
    // -------------------------------------------------------------------------
    // The role is read from `request.auth.token.role` — a Firebase Auth **custom
    // claim**, writable only by the Admin SDK. Two reasons it is not read from
    // `users/{id}.role`:
    //
    //   1. A claim costs no document read, so a role check cannot be made slow,
    //      and cannot recurse into the rules for the document it is checking.
    //   2. A user who somehow gained write access to their own profile still
    //      could not escalate, because the claim is what is consulted.
    //
    // The profile document keeps a copy for display. If they disagree, the claim
    // wins — see firebase/scripts/grantRole.mjs.

    function callerRole() {
      return isSignedIn() && 'role' in request.auth.token ? request.auth.token.role : 'user';
    }

    function isModerator() {
      return callerRole() in ['moderator', 'admin'];
    }

    // Note what is deliberately absent: no role grants **write** access anywhere
    // in this file. Privileged writes — approving a report, publishing a black
    // spot, appending to the audit trail — happen only through the Admin SDK in
    // the dashboard's server actions, which bypasses these rules entirely. So the
    // rules can stay at their strictest for every client, and the authorisation
    // for those writes lives in `evaluateModerationDecision`, which the dashboard
    // calls before the Admin SDK and which is tested independently.
    //
    // The practical effect is that there is no client path to approval at all —
    // for a user, a moderator, or an admin with a stolen mobile token.

    // Fields a user is never allowed to set or change on their own profile.
    // `role` is the important one: without this, any user could make themselves
    // an admin with a single client-side write and then approve their own
    // reports. Role changes happen only through the Admin SDK (Phase 7).
    function hasNoPrivilegedFields(data) {
      return !data.keys().hasAny(['role']);
    }

    function isValidProfileShape(data) {
      return data.keys().hasAll([
               'id', 'name', 'email', 'role',
               'alertRadiusM', 'alertsEnabled', 'backgroundMonitoringEnabled',
               'hapticsEnabled', 'soundEnabled', 'darkModePreference',
               'createdAt', 'updatedAt'
             ])
             && data.id is string
             && data.name is string
             && data.name.size() >= 2
             && data.name.size() <= 80
             && data.email is string
             && data.email.size() <= 320
             // Optional phone: present or absent, but must be a string if set.
             && (!data.keys().hasAny(['phone']) || data.phone is string)
             && data.alertRadiusM is int
             // Mirrors the client-side bounds in src/config/env.ts. Validating
             // server-side too means a tampered client cannot store a radius
             // that would make alerting useless or unbearable.
             && data.alertRadiusM >= 100
             && data.alertRadiusM <= 2000
             && data.alertsEnabled is bool
             && data.backgroundMonitoringEnabled is bool
             && data.hapticsEnabled is bool
             && data.soundEnabled is bool
             && data.darkModePreference in ['system', 'light', 'dark'];
    }

    // -------------------------------------------------------------------------
    // users/{userId}
    // -------------------------------------------------------------------------
    // A user document is private to its owner. Note there is deliberately no
    // `list` capability: allowing queries across the collection would expose
    // the full membership and every registered email address.
    match /users/{userId} {

      allow get: if isSelf(userId);

      // Registration. The document id must equal the caller's uid, so a user
      // cannot create a profile for somebody else, and `role` is pinned to
      // 'user' — self-assignment of a privileged role is rejected outright.
      allow create: if isSelf(userId)
                    && isValidProfileShape(request.resource.data)
                    && request.resource.data.id == userId
                    && request.resource.data.role == 'user';

      // Preference updates. The immutable fields below are excluded so a client
      // cannot rewrite its own identity, escalate its role, or backdate
      // createdAt to fake account age.
      allow update: if isSelf(userId)
                    && hasNoPrivilegedFields(request.resource.data.diff(resource.data).affectedKeys())
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['id', 'email', 'createdAt'])
                    && isValidProfileShape(request.resource.data);

      // Account deletion runs through a Cloud Function in Phase 12 so that the
      // Auth record, Storage objects and owned documents are removed together.
      // A client-side delete would orphan all of them.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // blackSpots/{blackSpotId}
    // -------------------------------------------------------------------------
    // Readable by any signed-in user, but ONLY where the document is both
    // verified and active. This is the rule that stops an algorithm candidate,
    // a deactivated spot, or a record still under review from ever reaching a
    // user as an official hazard.
    //
    // Note that `get` and `list` are granted separately, and `list` carries the
    // same condition: Firestore applies rules to each document a query returns,
    // so a query that could match an unverified document is rejected outright
    // rather than silently filtered. The repository's `where` clauses therefore
    // have to mirror this exactly — which is intentional, because it means a
    // client cannot ask for unverified data at all.
    match /blackSpots/{blackSpotId} {
      allow get, list: if isSignedIn()
                       && resource.data.verified == true
                       && resource.data.active == true;

      // Creating and editing black spots is an administrative action. It runs
      // through the Admin SDK in Phase 7, which bypasses these rules; no client
      // may write here regardless of role.
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // incidentReports/{reportId}
    // -------------------------------------------------------------------------
    // Crowdsourced reports. This is the collection where a mistake would be most
    // damaging: an unmoderated report that reached other users as an official
    // warning would be exactly the failure the whole approval flow exists to
    // prevent.
    //
    // Three properties do that work, and none of them depends on the client
    // behaving:
    //
    //   1. `status` may only ever be created as 'pending'. Not "should be" — the
    //      rule refuses any other value, so a tampered client that asks for
    //      'approved' has its write rejected outright rather than published.
    //   2. `moderationNotes`, `reviewedBy`, `reviewedAt` and `verified` may not
    //      be present on a client write at all. They are set by a moderator
    //      through the Admin SDK in Phase 7, which bypasses these rules.
    //   3. No client update path exists, so a report cannot be edited into a
    //      different status after the fact — see the note on `update` below.
    //
    // Note also what is NOT here: nothing in this collection is readable by
    // anyone but its author. Reports are not a public feed, approved or not.
    // Publication happens by an administrator creating a `blackSpots` document,
    // which is a separate, deliberate act.

    // Fields no client may ever write, in any operation.
    function hasNoModerationFields(data) {
      return !data.keys().hasAny(['verified', 'moderationNotes', 'reviewedBy', 'reviewedAt']);
    }

    function isValidReportShape(data) {
      return data.keys().hasAll([
               'reporterId', 'type', 'description', 'latitude', 'longitude',
               'geohash', 'severity', 'imageUrls', 'status',
               'createdAt', 'updatedAt'
             ])
             // Only the listed keys, plus the one optional field. An unexpected
             // key means the client and these rules disagree about the model,
             // and the safe response to that is refusal.
             && data.keys().hasOnly([
                  'reporterId', 'type', 'description', 'latitude', 'longitude',
                  'geohash', 'severity', 'imageUrls', 'status', 'occurredAt',
                  'createdAt', 'updatedAt'
                ])
             && data.type in ['accident', 'crime', 'pothole', 'unsafe-road', 'other']
             && data.severity in ['low', 'medium', 'high']
             && data.description is string
             // Mirrors DESCRIPTION_MIN_LENGTH / DESCRIPTION_MAX_LENGTH in
             // src/features/reports/reportSchemas.ts. Both copies exist on
             // purpose; only this one is a control.
             && data.description.size() >= 20
             && data.description.size() <= 1000
             && data.latitude is number
             && data.latitude >= -90 && data.latitude <= 90
             && data.longitude is number
             && data.longitude >= -180 && data.longitude <= 180
             && data.geohash is string
             && data.geohash.size() >= 1
             && data.geohash.size() <= 22
             && data.imageUrls is list
             // Mirrors MAX_IMAGES_PER_REPORT.
             && data.imageUrls.size() <= 3
             && (!data.keys().hasAny(['occurredAt']) || data.occurredAt is timestamp);
    }

    match /incidentReports/{reportId} {

      // A reporter reads only their own. There is no rule granting moderators
      // access here: the admin dashboard uses the Admin SDK, so widening this
      // for a client-side "moderator" role would add reach without adding a
      // capability anyone needs.
      allow get, list: if isSignedIn() && resource.data.reporterId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && isValidReportShape(request.resource.data)
                    && hasNoModerationFields(request.resource.data)
                    // The load-bearing line. Nothing a client submits is
                    // anything other than pending.
                    && request.resource.data.status == 'pending';

      // Deliberately closed. There is no feature that edits a submitted report,
      // and every field a user might want to change is one a moderator has
      // already read — silently rewriting the description under a review, or
      // flipping status after approval, are both worse than making the user file
      // a new report.
      //
      // TODO(phase-12): if withdrawing a pending report is added, it belongs
      // here as a narrow rule allowing the author to change status from
      // 'pending' to a 'withdrawn' state only, never to 'approved'.
      allow update: if false;

      // Deletion would destroy the evidence trail behind a published black spot.
      // Account deletion cascades through a Cloud Function in Phase 12.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // emergencyContacts/{contactId}
    // -------------------------------------------------------------------------
    // The most sensitive collection in the app. Every document is a real
    // person's name and phone number, held by someone else, and that person
    // never agreed to be here.
    //
    // Two consequences shape these rules:
    //
    //   1. **There is no read path for anyone but the owner** — not for
    //      moderators, not for admins, not for any future feature. A contact
    //      list is not moderation evidence and there is no legitimate reason for
    //      a second party to enumerate it.
    //   2. **Full CRUD is granted to the owner**, unlike incident reports. This
    //      is the user's own data about people they chose, and a wrong number
    //      they cannot correct is worse than useless in an emergency — so edit
    //      and delete are first-class, not routed through a Cloud Function.
    //
    // Note there is no cap on the number of contacts here. Firestore rules
    // cannot count documents in a collection without a read per evaluation, so
    // the limit is a client-side usability guard and is documented as such in
    // contactSchemas.ts rather than pretended to be a security control.

    function isValidContactShape(data) {
      return data.keys().hasAll(['userId', 'name', 'phone', 'isPrimary', 'createdAt', 'updatedAt'])
             // Only the listed keys, plus the one optional label. An unexpected
             // field means the client and these rules disagree about the model,
             // and refusal is the safe response.
             && data.keys().hasOnly([
                  'userId', 'name', 'phone', 'relationship', 'isPrimary',
                  'createdAt', 'updatedAt'
                ])
             && data.name is string
             // Mirrors CONTACT_NAME_MIN_LENGTH / CONTACT_NAME_MAX_LENGTH.
             && data.name.size() >= 2
             && data.name.size() <= 60
             && data.phone is string
             && data.phone.size() >= 1
             // Comfortably above E.164's 15 digits plus a leading '+'; bounded so
             // the field cannot be used to store arbitrary text.
             && data.phone.size() <= 20
             && data.isPrimary is bool
             && (!data.keys().hasAny(['relationship'])
                 || (data.relationship is string && data.relationship.size() <= 40));
    }

    match /emergencyContacts/{contactId} {

      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && isValidContactShape(request.resource.data);

      // `userId` and `createdAt` are immutable: reassigning a contact to another
      // account, or backdating it, serve no feature and would break the
      // ownership check this whole collection rests on.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && isValidContactShape(request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['userId', 'createdAt']);

      // Immediate, and deliberately so — see note 2 above.
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // alertLogs/{alertId}
    // -------------------------------------------------------------------------
    // Append-only, private to the user who was alerted.
    //
    // `latitude`/`longitude` are permitted but never written by the app — see
    // the note on the AlertLog type. Alert logs are write-once: allowing updates
    // or deletes would let a client rewrite its own history, and there is no
    // feature that needs it.
    match /alertLogs/{alertId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(
                         ['userId', 'blackSpotId', 'distanceM', 'alertType', 'createdAt'])
                    && request.resource.data.blackSpotId is string
                    && request.resource.data.distanceM is number
                    && request.resource.data.distanceM >= 0
                    && request.resource.data.alertType in ['foreground', 'background', 'push'];

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // adminAuditLogs/{entryId}
    // -------------------------------------------------------------------------
    // The record of every privileged action.
    //
    // **No client may write here at all** — not a moderator, not an admin. Entries
    // are created only by the Admin SDK inside the dashboard's server actions,
    // where each one is committed in the same transaction as the action it
    // records. An audit trail that the people it audits can append to, amend or
    // delete is not an audit trail, and `if false` on write is the only way to
    // say that unambiguously.
    //
    // Reads are open to moderators as well as admins, deliberately: a log that
    // only the most privileged accounts can inspect is a poor check on those
    // accounts. It is not readable by ordinary users, because the entries name
    // which moderator decided what and that is not public information.
    match /adminAuditLogs/{entryId} {
      allow get, list: if isModerator();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Everything else: denied until a phase adds an explicit rule.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
