rules_version = '2';

// =============================================================================
// Firestore security rules
// =============================================================================
// Reviewed end to end in Phase 12. Every collection named in `COLLECTIONS`
// (packages/shared-types/src/vocabulary.ts) has a block below, and
// `tests/coverage.test.mjs` fails if that stops being true in either direction.
//
// Default posture is deny-all. A collection is unreachable until a rule below
// explicitly grants access, so forgetting to write a rule fails closed.
//
// -----------------------------------------------------------------------------
// The four properties this file exists to hold
// -----------------------------------------------------------------------------
//
//  1. **No client can publish a warning.** `blackSpots` is write-denied to every
//     client, reports can only ever be created as `pending`, and
//     `blackSpotCandidates` — the algorithm's output — is unreadable by the
//     mobile app and unwritable by anyone.
//
//  2. **Nobody approves their own report.** Enforced in
//     `evaluateModerationDecision`, on the Admin SDK path, because there is no
//     client approval path at all for these rules to guard.
//
//  3. **A reporter's identity stays with the reporter.** `incidentReports` is
//     readable only by its author. Moderators reach reports through the Admin
//     SDK, and the dashboard pseudonymises `reporterId` before it reaches a
//     browser — see apps/admin/src/lib/reporterPrivacy.ts.
//
//  4. **Submission is bounded.** Rate limits and duplicate detection are
//     enforced here rather than in the app, using the batch-coupling technique
//     documented on `reportRateLimits` below.
//
// -----------------------------------------------------------------------------
// Two conventions used throughout
// -----------------------------------------------------------------------------
//
// **`hasOnly` on every client-written shape.** Firestore charges by document
// size and these documents are written by a device we do not control. Without an
// exact key list a client can attach arbitrary fields to its own profile and use
// the database as free storage — and a field nobody expects is a field nobody
// validates. An unexpected key means the client and these rules disagree about
// the model, and refusal is the safe response to that.
//
// **Server time on every timestamp a client writes.** `createdAt == request.time`
// is satisfiable only by `serverTimestamp()`. A device clock can be wrong, and
// can be set deliberately: without this, a client could backdate a report to
// distort the Phase 10 clustering, or forward-date a rate-limit counter to
// escape its own window.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Roles (Phase 7)
    // -------------------------------------------------------------------------
    // The role is read from `request.auth.token.role` — a Firebase Auth **custom
    // claim**, writable only by the Admin SDK. Two reasons it is not read from
    // `users/{id}.role`:
    //
    //   1. A claim costs no document read, so a role check cannot be made slow,
    //      and cannot recurse into the rules for the document it is checking.
    //   2. A user who somehow gained write access to their own profile still
    //      could not escalate, because the claim is what is consulted.
    //
    // The profile document keeps a copy for display. If they disagree, the claim
    // wins — see firebase/scripts/grantRole.mjs.

    function callerRole() {
      return isSignedIn() && 'role' in request.auth.token ? request.auth.token.role : 'user';
    }

    function isModerator() {
      return callerRole() in ['moderator', 'admin'];
    }

    // -------------------------------------------------------------------------
    // Server time (Phase 12)
    // -------------------------------------------------------------------------
    // `request.time` is the server's commit timestamp, and it is identical for
    // every write in a single commit. Two things follow, and both are used
    // below:
    //
    //   1. A field required to equal it can only have been written with
    //      `serverTimestamp()`. A client cannot forge it, because it does not
    //      know the value.
    //   2. Requiring it on a *sibling* document, read through `getAfter`, proves
    //      that sibling was written in the same commit — which is what couples a
    //      report to its rate-limit counter.

    function isServerTime(value) {
      return value == request.time;
    }

    /** A document whose createdAt and updatedAt were both stamped by the server. */
    function hasServerTimestamps(data) {
      return isServerTime(data.createdAt) && isServerTime(data.updatedAt);
    }

    // Note what is deliberately absent: no role grants **write** access anywhere
    // in this file. Privileged writes — approving a report, publishing a black
    // spot, appending to the audit trail — happen only through the Admin SDK in
    // the dashboard's server actions, which bypasses these rules entirely. So the
    // rules can stay at their strictest for every client, and the authorisation
    // for those writes lives in `evaluateModerationDecision`, which the dashboard
    // calls before the Admin SDK and which is tested independently.
    //
    // The practical effect is that there is no client path to approval at all —
    // for a user, a moderator, or an admin with a stolen mobile token.

    // Fields a user is never allowed to set or change on their own profile.
    // `role` is the important one: without this, any user could make themselves
    // an admin with a single client-side write and then approve their own
    // reports. Role changes happen only through the Admin SDK (Phase 7).
    function hasNoPrivilegedFields(data) {
      return !data.keys().hasAny(['role']);
    }

    function isValidProfileShape(data) {
      return data.keys().hasAll([
               'id', 'name', 'email', 'role',
               'alertRadiusM', 'alertsEnabled', 'backgroundMonitoringEnabled',
               'hapticsEnabled', 'soundEnabled', 'darkModePreference',
               'createdAt', 'updatedAt'
             ])
             // Phase 12. Without this a user could attach unlimited arbitrary
             // fields to their own profile — the one document in the database
             // they are allowed to write freely — and use it as free storage.
             && data.keys().hasOnly([
                  'id', 'name', 'email', 'phone', 'role',
                  'alertRadiusM', 'alertsEnabled', 'backgroundMonitoringEnabled',
                  'hapticsEnabled', 'soundEnabled', 'darkModePreference',
                  'createdAt', 'updatedAt'
                ])
             && data.id is string
             && data.name is string
             && data.name.size() >= 2
             && data.name.size() <= 80
             && data.email is string
             && data.email.size() <= 320
             // Optional phone: present or absent, but must be a string if set.
             && (!data.keys().hasAny(['phone']) || data.phone is string)
             && data.alertRadiusM is int
             // Mirrors the client-side bounds in src/config/env.ts. Validating
             // server-side too means a tampered client cannot store a radius
             // that would make alerting useless or unbearable.
             && data.alertRadiusM >= 100
             && data.alertRadiusM <= 2000
             && data.alertsEnabled is bool
             && data.backgroundMonitoringEnabled is bool
             && data.hapticsEnabled is bool
             && data.soundEnabled is bool
             && data.darkModePreference in ['system', 'light', 'dark'];
    }

    // -------------------------------------------------------------------------
    // users/{userId}
    // -------------------------------------------------------------------------
    // A user document is private to its owner. Note there is deliberately no
    // `list` capability: allowing queries across the collection would expose
    // the full membership and every registered email address.
    match /users/{userId} {

      allow get: if isSelf(userId);

      // Registration. The document id must equal the caller's uid, so a user
      // cannot create a profile for somebody else, and `role` is pinned to
      // 'user' — self-assignment of a privileged role is rejected outright.
      allow create: if isSelf(userId)
                    && isValidProfileShape(request.resource.data)
                    && request.resource.data.id == userId
                    && request.resource.data.role == 'user'
                    && hasServerTimestamps(request.resource.data);

      // Preference updates. The immutable fields below are excluded so a client
      // cannot rewrite its own identity, escalate its role, or backdate
      // createdAt to fake account age.
      allow update: if isSelf(userId)
                    && hasNoPrivilegedFields(request.resource.data.diff(resource.data).affectedKeys())
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['id', 'email', 'createdAt'])
                    && isValidProfileShape(request.resource.data)
                    // `createdAt` is already immutable above; this pins the new
                    // `updatedAt` to the server clock so the field cannot be used
                    // to smuggle an arbitrary value past the shape check.
                    && isServerTime(request.resource.data.updatedAt);

      // Account deletion runs through the `deleteAccount` Cloud Function, which
      // removes the Auth record, the Storage objects and every owned document
      // together. A client-side delete would orphan all of them: the rules below
      // deny deletion of a user's reports and alert logs, so a user who could
      // delete only their profile would leave the rest behind with no owner and
      // no way to reach it.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // blackSpots/{blackSpotId}
    // -------------------------------------------------------------------------
    // Readable by any signed-in user, but ONLY where the document is both
    // verified and active. This is the rule that stops an algorithm candidate,
    // a deactivated spot, or a record still under review from ever reaching a
    // user as an official hazard.
    //
    // Note that `get` and `list` are granted separately, and `list` carries the
    // same condition: Firestore applies rules to each document a query returns,
    // so a query that could match an unverified document is rejected outright
    // rather than silently filtered. The repository's `where` clauses therefore
    // have to mirror this exactly — which is intentional, because it means a
    // client cannot ask for unverified data at all.
    match /blackSpots/{blackSpotId} {
      allow get, list: if isSignedIn()
                       && resource.data.verified == true
                       && resource.data.active == true;

      // Creating and editing black spots is an administrative action. It runs
      // through the Admin SDK in Phase 7, which bypasses these rules; no client
      // may write here regardless of role.
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // incidentReports/{reportId}
    // -------------------------------------------------------------------------
    // Crowdsourced reports. This is the collection where a mistake would be most
    // damaging: an unmoderated report that reached other users as an official
    // warning would be exactly the failure the whole approval flow exists to
    // prevent.
    //
    // Three properties do that work, and none of them depends on the client
    // behaving:
    //
    //   1. `status` may only ever be created as 'pending'. Not "should be" — the
    //      rule refuses any other value, so a tampered client that asks for
    //      'approved' has its write rejected outright rather than published.
    //   2. `moderationNotes`, `reviewedBy`, `reviewedAt` and `verified` may not
    //      be present on a client write at all. They are set by a moderator
    //      through the Admin SDK in Phase 7, which bypasses these rules.
    //   3. No client update path exists, so a report cannot be edited into a
    //      different status after the fact — see the note on `update` below.
    //
    // Note also what is NOT here: nothing in this collection is readable by
    // anyone but its author. Reports are not a public feed, approved or not.
    // Publication happens by an administrator creating a `blackSpots` document,
    // which is a separate, deliberate act.

    // Fields no client may ever write, in any operation.
    function hasNoModerationFields(data) {
      return !data.keys().hasAny(['verified', 'moderationNotes', 'reviewedBy', 'reviewedAt']);
    }

    function isValidReportShape(data) {
      return data.keys().hasAll([
               'reporterId', 'type', 'description', 'latitude', 'longitude',
               'geohash', 'severity', 'imageUrls', 'status',
               'createdAt', 'updatedAt'
             ])
             // Only the listed keys, plus the one optional field. An unexpected
             // key means the client and these rules disagree about the model,
             // and the safe response to that is refusal.
             && data.keys().hasOnly([
                  'reporterId', 'type', 'description', 'latitude', 'longitude',
                  'geohash', 'severity', 'imageUrls', 'status', 'occurredAt',
                  'createdAt', 'updatedAt'
                ])
             && data.type in ['accident', 'crime', 'pothole', 'unsafe-road', 'other']
             && data.severity in ['low', 'medium', 'high']
             && data.description is string
             // Mirrors DESCRIPTION_MIN_LENGTH / DESCRIPTION_MAX_LENGTH in
             // src/features/reports/reportSchemas.ts. Both copies exist on
             // purpose; only this one is a control.
             && data.description.size() >= 20
             && data.description.size() <= 1000
             && data.latitude is number
             && data.latitude >= -90 && data.latitude <= 90
             && data.longitude is number
             && data.longitude >= -180 && data.longitude <= 180
             && data.geohash is string
             // The lower bound is 7, not 1, because the fingerprint below slices
             // the first 7 characters. Enforced before the slice is evaluated,
             // so a short geohash is refused rather than producing an error.
             && data.geohash.size() >= 7
             && data.geohash.size() <= 22
             && data.imageUrls is list
             // Mirrors MAX_IMAGES_PER_REPORT.
             && data.imageUrls.size() <= 3
             && (!data.keys().hasAny(['occurredAt']) || data.occurredAt is timestamp);
    }

    // -------------------------------------------------------------------------
    // Submission limits (Phase 12)
    // -------------------------------------------------------------------------
    // The id of the fingerprint document that a given report must claim,
    // rebuilt here from the report's **own fields** rather than taken from the
    // request. That is the whole trick: a client cannot satisfy the duplicate
    // check by pointing at an unrelated document, because it does not get to
    // choose which document is consulted.
    //
    // Must stay identical to `buildReportFingerprintId` in
    // packages/shared-types/src/reportLimits.ts, which the client uses to
    // produce a readable message instead of a bare PERMISSION_DENIED.
    function fingerprintIdFor(data) {
      return request.auth.uid + '__' + data.type + '__' + data.geohash[0:7];
    }

    function rateLimitAfter() {
      return getAfter(/databases/$(database)/documents/reportRateLimits/$(request.auth.uid)).data;
    }

    function fingerprintAfter(data) {
      return getAfter(/databases/$(database)/documents/reportFingerprints/$(fingerprintIdFor(data))).data;
    }

    match /incidentReports/{reportId} {

      // A reporter reads only their own. There is no rule granting moderators
      // access here: the admin dashboard uses the Admin SDK, so widening this
      // for a client-side "moderator" role would add reach without adding a
      // capability anyone needs. This is the rule behind the phase gate
      // "reporter identity is private" — there is no query any signed-in user
      // can run that returns another person's `reporterId`.
      allow get, list: if isSignedIn() && resource.data.reporterId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && isValidReportShape(request.resource.data)
                    && hasNoModerationFields(request.resource.data)
                    // The load-bearing line. Nothing a client submits is
                    // anything other than pending.
                    && request.resource.data.status == 'pending'
                    && hasServerTimestamps(request.resource.data)

                    // ----- Rate limit --------------------------------------
                    // `getAfter` reads the counter's state *after this commit*.
                    // Requiring its `lastReportAt` to equal `request.time`
                    // therefore means the counter was written in this very
                    // commit — a lone report write leaves a stale counter and is
                    // refused. Verified against the emulator, not assumed.
                    //
                    // The counter's own rules (below) are what constrain the new
                    // value; the cap is repeated here so that a mistake in either
                    // place fails closed rather than opening a gap.
                    && isServerTime(rateLimitAfter().lastReportAt)
                    && rateLimitAfter().count <= 10

                    // ----- Duplicate detection -----------------------------
                    // The fingerprint must be claimed by *this* report. A second
                    // report about the same incident type, at the same place, by
                    // the same person carries a different id and so cannot claim
                    // a fingerprint the first one still holds.
                    && isServerTime(fingerprintAfter(request.resource.data).lastReportAt)
                    && fingerprintAfter(request.resource.data).reportId == reportId;

      // Deliberately closed. There is no feature that edits a submitted report,
      // and every field a user might want to change is one a moderator has
      // already read — silently rewriting the description under a review, or
      // flipping status after approval, are both worse than making the user file
      // a new report.
      //
      // Reviewed in Phase 12 and deliberately left closed. Withdrawal is not a
      // feature; if it is ever added it belongs here as a narrow rule allowing
      // the author to move `status` from 'pending' to a 'withdrawn' state only,
      // never to 'approved'.
      //
      // Note the interaction with the retry path: because this is closed, a
      // `setDoc` onto a report that already exists is evaluated as an `update`
      // and refused. `submitIncidentReport` therefore treats "the document is
      // already there and is mine" as success rather than retrying into a
      // permission error — see the note there.
      allow update: if false;

      // Deletion would destroy the evidence trail behind a published black spot.
      // Account deletion cascades through the `deleteAccount` Cloud Function,
      // which uses the Admin SDK and so is not bound by this line.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // reportRateLimits/{userId}   (Phase 12)
    // -------------------------------------------------------------------------
    // A per-user submission counter, written by the user themselves.
    //
    // That sounds like asking the fox to count the hens, and it would be if the
    // rules validated the *value*. They validate the **transition** instead, and
    // there are only two legal ones:
    //
    //   - within the current window: `count` goes up by exactly one and stays
    //     at or below the cap, and `windowStartAt` does not move;
    //   - after the window has elapsed: `count` resets to one and
    //     `windowStartAt` becomes now.
    //
    // Everything a client might try instead is closed off:
    //
    //   * writing a lower count, or a count that does not increment — refused,
    //     the transition is exact;
    //   * moving `windowStartAt` forward to escape the window — refused, it must
    //     either be unchanged or equal `request.time`;
    //   * back-dating `lastReportAt` to defeat the minimum gap — refused, it must
    //     equal `request.time`, which only `serverTimestamp()` produces;
    //   * deleting the document to start over — refused below;
    //   * simply not writing it — refused by the `getAfter` coupling on the
    //     report itself, which is the piece that makes all of this binding.
    //
    // The constants are duplicated from `REPORT_RATE_LIMIT` in
    // packages/shared-types/src/reportLimits.ts because a rules file cannot
    // import. `tests/limits.test.mjs` asserts the two agree, so drift fails the
    // build rather than silently changing the limit.

    function isValidRateLimitShape(data) {
      return data.keys().hasOnly(['userId', 'windowStartAt', 'count', 'lastReportAt'])
             && data.keys().hasAll(['userId', 'windowStartAt', 'count', 'lastReportAt'])
             && data.userId == request.auth.uid
             && data.count is int
             && data.count >= 1
             && data.windowStartAt is timestamp
             && isServerTime(data.lastReportAt);
    }

    /** True while the window that began at `startedAt` is still current. */
    function withinWindow(startedAt) {
      return request.time <= startedAt + duration.value(24, 'h');
    }

    match /reportRateLimits/{userId} {

      // The owner may read their own counter so the app can say "you have
      // reached today's limit" before attempting a write that would only come
      // back as PERMISSION_DENIED. No list capability: the collection is keyed
      // by uid, so listing it would enumerate everyone who has ever reported.
      allow get: if isSelf(userId);

      allow create: if isSelf(userId)
                    && isValidRateLimitShape(request.resource.data)
                    && request.resource.data.count == 1
                    && isServerTime(request.resource.data.windowStartAt);

      allow update: if isSelf(userId)
                    && isValidRateLimitShape(request.resource.data)
                    // Anti-flood: at least this long between two submissions.
                    && request.time > resource.data.lastReportAt + duration.value(60, 's')
                    && (
                         // Window elapsed — start a new one.
                         (
                           !withinWindow(resource.data.windowStartAt)
                           && request.resource.data.count == 1
                           && isServerTime(request.resource.data.windowStartAt)
                         )
                         ||
                         // Still inside the window — spend one of the allowance.
                         (
                           withinWindow(resource.data.windowStartAt)
                           && request.resource.data.windowStartAt == resource.data.windowStartAt
                           && request.resource.data.count == resource.data.count + 1
                           && request.resource.data.count <= 10
                         )
                       );

      // The counter must be monotonic within its window. If it could be deleted,
      // the next `create` would reset the allowance to one and the limit would
      // mean nothing.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // reportFingerprints/{fingerprintId}   (Phase 12)
    // -------------------------------------------------------------------------
    // Server-side duplicate detection.
    //
    // The document id is `{uid}__{type}__{geohash[0:7]}` — reporter, incident
    // type, and a ~150 m cell. The report rule above **recomputes that id from
    // the report's own fields**, so the client does not get to nominate which
    // fingerprint is checked. Whichever document it writes, the one consulted is
    // the one derived from what it claims to be reporting.
    //
    // The stored `reportId` is what keeps retries working. A submission that the
    // server committed but whose response was lost is retried with the same
    // reserved id, re-claims its own fingerprint, and is allowed. A second,
    // genuinely new report carries a different id and is refused until the
    // window expires.
    //
    // Note what this is not: a proximity check. A grid cell has edges, and two
    // reports 20 m apart can fall either side of one. It suppresses casual and
    // accidental repeats; the rigorous version is the haversine dedupe the
    // analytics service runs on ingest, where real distances are available.

    function isValidFingerprintShape(data, fingerprintId) {
      return data.keys().hasOnly(['reporterId', 'reportId', 'lastReportAt'])
             && data.keys().hasAll(['reporterId', 'reportId', 'lastReportAt'])
             && data.reporterId == request.auth.uid
             && data.reportId is string
             && data.reportId.size() > 0
             && data.reportId.size() <= 128
             && isServerTime(data.lastReportAt)
             // The id must begin with the caller's own uid. Not a security
             // control — a fingerprint filed under someone else's prefix is
             // simply never consulted, because the report rule derives the path
             // from `request.auth.uid`. It is here so the collection cannot be
             // used as a scratch space of arbitrary documents.
             && fingerprintId[0:request.auth.uid.size()] == request.auth.uid;
    }

    match /reportFingerprints/{fingerprintId} {

      // Readable by its owner so the app can explain a refusal. The id itself
      // encodes a place the user reported from, so no list capability: listing
      // would hand any signed-in caller a map of where people report.
      allow get: if isSignedIn()
                 && fingerprintId[0:request.auth.uid.size()] == request.auth.uid;

      allow create: if isSignedIn() && isValidFingerprintShape(request.resource.data, fingerprintId);

      allow update: if isSignedIn()
                    && isValidFingerprintShape(request.resource.data, fingerprintId)
                    && resource.data.reporterId == request.auth.uid
                    && (
                         // The same submission, retried. Idempotent.
                         request.resource.data.reportId == resource.data.reportId
                         ||
                         // Or the previous report here is old enough that a new
                         // one is a new event rather than a duplicate. A black
                         // spot is somewhere things happen repeatedly, so this
                         // must expire — a permanent fingerprint would suppress
                         // exactly the corroboration the analytics service looks
                         // for.
                         request.time > resource.data.lastReportAt + duration.value(6, 'h')
                       );

      // Deleting a fingerprint would clear the duplicate window early, which is
      // the entire thing it exists to hold.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // emergencyContacts/{contactId}
    // -------------------------------------------------------------------------
    // The most sensitive collection in the app. Every document is a real
    // person's name and phone number, held by someone else, and that person
    // never agreed to be here.
    //
    // Two consequences shape these rules:
    //
    //   1. **There is no read path for anyone but the owner** — not for
    //      moderators, not for admins, not for any future feature. A contact
    //      list is not moderation evidence and there is no legitimate reason for
    //      a second party to enumerate it.
    //   2. **Full CRUD is granted to the owner**, unlike incident reports. This
    //      is the user's own data about people they chose, and a wrong number
    //      they cannot correct is worse than useless in an emergency — so edit
    //      and delete are first-class, not routed through a Cloud Function.
    //
    // Note there is no cap on the number of contacts here. Firestore rules
    // cannot count documents in a collection without a read per evaluation, so
    // the limit is a client-side usability guard and is documented as such in
    // contactSchemas.ts rather than pretended to be a security control.

    function isValidContactShape(data) {
      return data.keys().hasAll(['userId', 'name', 'phone', 'isPrimary', 'createdAt', 'updatedAt'])
             // Only the listed keys, plus the one optional label. An unexpected
             // field means the client and these rules disagree about the model,
             // and refusal is the safe response.
             && data.keys().hasOnly([
                  'userId', 'name', 'phone', 'relationship', 'isPrimary',
                  'createdAt', 'updatedAt'
                ])
             && data.name is string
             // Mirrors CONTACT_NAME_MIN_LENGTH / CONTACT_NAME_MAX_LENGTH.
             && data.name.size() >= 2
             && data.name.size() <= 60
             && data.phone is string
             && data.phone.size() >= 1
             // Comfortably above E.164's 15 digits plus a leading '+'; bounded so
             // the field cannot be used to store arbitrary text.
             && data.phone.size() <= 20
             && data.isPrimary is bool
             && (!data.keys().hasAny(['relationship'])
                 || (data.relationship is string && data.relationship.size() <= 40));
    }

    match /emergencyContacts/{contactId} {

      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && isValidContactShape(request.resource.data)
                    && hasServerTimestamps(request.resource.data);

      // `userId` and `createdAt` are immutable: reassigning a contact to another
      // account, or backdating it, serve no feature and would break the
      // ownership check this whole collection rests on.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && isValidContactShape(request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['userId', 'createdAt'])
                    && isServerTime(request.resource.data.updatedAt);

      // Immediate, and deliberately so — see note 2 above.
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // alertLogs/{alertId}
    // -------------------------------------------------------------------------
    // Append-only, private to the user who was alerted.
    //
    // `latitude`/`longitude` are permitted but never written by the app — see
    // the note on the AlertLog type. Alert logs are write-once: allowing updates
    // or deletes would let a client rewrite its own history, and there is no
    // feature that needs it.
    match /alertLogs/{alertId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(
                         ['userId', 'blackSpotId', 'distanceM', 'alertType', 'createdAt'])
                    // Phase 12. The optional coordinates are the only extra keys
                    // permitted; without `hasOnly` this append-only, never-read
                    // collection is an unbounded write target for any signed-in
                    // client, and it is the one place a client may create
                    // documents without limit.
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'blackSpotId', 'distanceM', 'alertType',
                          'latitude', 'longitude', 'createdAt'])
                    && request.resource.data.blackSpotId is string
                    && request.resource.data.blackSpotId.size() > 0
                    && request.resource.data.blackSpotId.size() <= 128
                    && request.resource.data.distanceM is number
                    && request.resource.data.distanceM >= 0
                    && request.resource.data.alertType in ['foreground', 'background', 'push']
                    // An alert log is evidence about when a warning was shown.
                    // A client clock would make that evidence worthless.
                    && isServerTime(request.resource.data.createdAt)
                    && (!request.resource.data.keys().hasAny(['latitude'])
                        || (request.resource.data.latitude is number
                            && request.resource.data.latitude >= -90
                            && request.resource.data.latitude <= 90))
                    && (!request.resource.data.keys().hasAny(['longitude'])
                        || (request.resource.data.longitude is number
                            && request.resource.data.longitude >= -180
                            && request.resource.data.longitude <= 180));

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // adminAuditLogs/{entryId}
    // -------------------------------------------------------------------------
    // The record of every privileged action.
    //
    // **No client may write here at all** — not a moderator, not an admin. Entries
    // are created only by the Admin SDK inside the dashboard's server actions,
    // where each one is committed in the same transaction as the action it
    // records. An audit trail that the people it audits can append to, amend or
    // delete is not an audit trail, and `if false` on write is the only way to
    // say that unambiguously.
    //
    // Reads are open to moderators as well as admins, deliberately: a log that
    // only the most privileged accounts can inspect is a poor check on those
    // accounts. It is not readable by ordinary users, because the entries name
    // which moderator decided what and that is not public information.
    match /adminAuditLogs/{entryId} {
      allow get, list: if isModerator();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // blackSpotCandidates/{candidateId}
    // -------------------------------------------------------------------------
    // Black spots *proposed* by the Phase 10 analytics service. Proposals, not
    // warnings.
    //
    // This is the collection where the project's central rule is enforced: an
    // algorithm must never be able to put a hazard warning in front of users on
    // its own. Three things hold that line, and none of them relies on a client
    // behaving:
    //
    //   1. **The mobile app cannot read this collection at all.** Not "reads it
    //      and filters" — cannot read it. A bug in the app's query therefore
    //      cannot surface a candidate, because there is no query that succeeds.
    //   2. **No client may write here**, whatever their role. Candidates are
    //      written by the analytics service through the Admin SDK, which
    //      bypasses these rules; a client with a stolen moderator token still
    //      cannot manufacture one.
    //   3. **A candidate is a different shape from a black spot.** It carries no
    //      `verified` and no `active` field, so it could not satisfy the app's
    //      `verified == true && active == true` query even if it were somehow
    //      copied across.
    //
    // Publishing means an administrator creating a document in `blackSpots` —
    // a separate, deliberate, audited act, and one this collection cannot cause.
    match /blackSpotCandidates/{candidateId} {
      // Moderators as well as admins: the queue is reviewed by moderators, and
      // a proposal only an admin can see is a proposal nobody reviews.
      allow get, list: if isModerator();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // analysisJobs/{jobId}
    // -------------------------------------------------------------------------
    // Metadata for each analytics run: what was ingested, what parameters were
    // used, which algorithm version produced the result.
    //
    // Readable by moderators so a candidate can be traced back to the run that
    // proposed it — a moderator asked to trust a score is entitled to know which
    // version of the algorithm produced it. Not readable by ordinary users: the
    // counts describe the shape of the whole report corpus, including how many
    // reports were rejected, which is not public information.
    //
    // Written only by the analytics service through the Admin SDK.
    match /analysisJobs/{jobId} {
      allow get, list: if isModerator();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // deletedAccounts/{tombstoneId}   (Phase 12)
    // -------------------------------------------------------------------------
    // Written by the `deleteAccount` Cloud Function when an account is erased.
    //
    // **Closed to every client, including the account's former owner** — after
    // deletion there is no signed-in owner left to read it, and before deletion
    // there is nothing to read.
    //
    // What it holds is deliberately minimal and deliberately not personal: a
    // random tombstone id, counts of what was removed, and the time. It exists
    // so an operator can answer "was this account's data actually deleted, and
    // when" without retaining the account. It carries no uid, no email and no
    // location — a deletion record that identified the person would defeat the
    // deletion. See functions/src/deleteAccount.ts.
    match /deletedAccounts/{tombstoneId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Everything else: denied.
    // -------------------------------------------------------------------------
    // Reached only by a collection nobody wrote a rule for. `tests/coverage.test.mjs`
    // asserts that every name in `COLLECTIONS` has a block above, so arriving
    // here means a genuinely unknown path — and denial is the right answer to
    // one of those.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
