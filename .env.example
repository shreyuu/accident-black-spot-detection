# =============================================================================
# accident-black-spot-detection — environment template
# =============================================================================
# Copy to `.env` in apps/mobile and fill in real values. `.env` is gitignored.
#
#   cp .env.example apps/mobile/.env
#
# IMPORTANT: every variable read by the mobile app must be prefixed
# EXPO_PUBLIC_. Expo inlines these into the JavaScript bundle at build time,
# so they are NOT secret — anyone with the app binary can read them.
# Never put a private key, Firebase Admin credential, or database password here.
#
# Values are validated at startup by apps/mobile/src/config/env.ts (Zod).
# A malformed value fails loudly rather than causing confusing runtime bugs.
# =============================================================================

# -----------------------------------------------------------------------------
# Application environment
# -----------------------------------------------------------------------------
# One of: development | preview | production
EXPO_PUBLIC_APP_ENV=development


# -----------------------------------------------------------------------------
# Default proximity alert radius, in metres
# -----------------------------------------------------------------------------
# Must be between 100 and 2000. Users can override this in Settings (Phase 11).
EXPO_PUBLIC_DEFAULT_ALERT_RADIUS_M=1000


# -----------------------------------------------------------------------------
# Firebase Web SDK configuration
# -----------------------------------------------------------------------------
# These identify the project; they are not credentials. Access control comes
# from Firebase Authentication plus Firestore/Storage security rules.
#
# Validation is all-or-nothing: provide every value or leave the whole block
# blank, so a half-configured project fails at startup with a clear message
# instead of failing opaquely at the first network call.
#
# The values below are the EMULATOR defaults and are ready to use as-is — this
# is the recommended setup for local development. The "demo-" project prefix is
# meaningful to Firebase: it guarantees the SDK can never reach real Google
# Cloud, so no account, credentials or billing are involved. The Auth emulator
# accepts any API key, which is why the placeholder below works.
#
# Start the emulators with `npm run emulators` before launching the app.
#
# To target a real Firebase project instead, replace all six values with the
# ones from Firebase console -> Project settings -> Your apps -> Web app config,
# and set EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-accident-black-spot-detection.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-accident-black-spot-detection
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-accident-black-spot-detection.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Point the app at the local Firebase Emulator Suite instead of production.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# Host the emulators are reachable on from the device or simulator.
#   iOS simulator      -> localhost
#   Android emulator   -> 10.0.2.2   (the emulator's alias for the host machine;
#                                     "localhost" there means the device itself)
#   Physical device    -> your machine's LAN IP, e.g. 192.168.1.20
#
# Leave this as "localhost": the app detects the Android emulator at runtime and
# substitutes 10.0.2.2 automatically, so one .env works for both platforms.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost


# -----------------------------------------------------------------------------
# Google Maps Platform  (Phase 3 / Phase 9)
# -----------------------------------------------------------------------------
# Optional. iOS uses Apple Maps by default and needs no key.
# Required for provider={PROVIDER_GOOGLE} on iOS and for any Android release
# binary. Restrict each key to the matching bundle id / package name + SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=


# -----------------------------------------------------------------------------
# Nearby facilities  (Phase 9)
# -----------------------------------------------------------------------------
# Optional, and LEAVE IT BLANK unless you have a reason not to.
#
# Blank is the supported default: the app looks up hospitals and police stations
# through OpenStreetMap's Overpass API, which needs no credential at all. That is
# deliberate — no key means nothing to leak and nothing to bill.
#
# Setting this enables the Google Places provider as well, with OpenStreetMap as
# the automatic fallback. Better coverage in some regions, at a cost:
#
#   * EXPO_PUBLIC_* values are inlined into the shipped JavaScript bundle and can
#     be extracted from the app in minutes. THIS IS NOT A SECRET and cannot be
#     made one client-side. Protect it with restrictions, not with secrecy:
#       - restrict by iOS bundle id / Android package name + signing SHA-1
#       - restrict to the Places API only
#       - set a daily quota cap so a leak is bounded in cost
#   * Places API calls are billable.
#
# The private option is to proxy the call through a server that holds the key.
# See docs/nearby-places.md.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=


# -----------------------------------------------------------------------------
# Analytics service  (Phase 10)
# -----------------------------------------------------------------------------
# Base URL of the FastAPI analytics service. Only the admin dashboard and Cloud
# Functions call it — the mobile app never triggers ECLAT processing directly.
ANALYTICS_SERVICE_URL=http://localhost:8000
