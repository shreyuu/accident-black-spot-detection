# =============================================================================
# Analytics service — environment template
# =============================================================================
# Copy to services/analytics/.env and adjust. `.env` is gitignored.
#
#   cp services/analytics/.env.example services/analytics/.env
#
# The emulator defaults below work as-is. Values are validated at startup by
# app/config.py (pydantic-settings); a malformed value fails loudly.
#
# UNLIKE the mobile app, this service runs on a server, so values here CAN be
# genuine secrets. That is the whole reason it exists as a separate deployable:
# the mobile app must never hold an Admin SDK credential, and every
# EXPO_PUBLIC_* value is readable from the shipped binary.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-accident-black-spot-detection

# Point the Admin SDK at the Firestore emulator. When set, no credentials are
# needed or used. Every phase of this project has run this way.
#
# Leave it set unless you are deliberately targeting a real project — in which
# case unset it and set GOOGLE_APPLICATION_CREDENTIALS instead. Setting both is
# a configuration this service should not be asked to interpret.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Real project only. Absolute path to a service-account JSON file.
# Never commit the file, and never place it inside this repository —
# `.gitignore` refuses the usual filenames, but the safest path is one that is
# not under the repository root at all.
#
# UNEXERCISED: this project has only ever run against the emulator.
# GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Authentication for the trigger endpoint
# -----------------------------------------------------------------------------
# Bearer token required by POST /analyse.
#
# Analysis is expensive and writes to the moderation queue, so it is not
# something an unauthenticated caller should be able to start.
#
# UNSET MEANS EVERY REQUEST IS REFUSED, not that every request is allowed —
# failing closed, matching the Firestore rules' default posture. So a service
# started with no token here is inert rather than open, and the demo below will
# return 401 until you set one.
#
# The value below is a demonstration token for local use against the emulator.
# It protects nothing real. Generate a random one for any deployment.
ANALYSIS_API_TOKEN=demo-token

# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------
# Maximum reports read in one run. Bounds memory and runtime.
MAX_REPORTS_PER_RUN=50000
