# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build output. Generated by `expo prebuild` — regenerate, never commit.
/apps/mobile/ios/
/apps/mobile/android/
.kotlin/
*.orig.*

# The same output, one directory up. `expo prebuild` run from the repository
# root instead of `apps/mobile` writes here, and in Phase 14 it did: commit
# cbd8a2d tracked a full Xcode project at `/ios` carrying the Expo template's
# default identity (`org.name.accidentblackspotdetection`, version 1.0) rather
# than this app's (`com.shreyuu.accidentblackspotdetection`, 0.1.0). Nothing
# referenced it — `docs/ios-device-builds.md` documents the *real* device build,
# which `expo run:ios` generates under `apps/mobile/ios/`.
#
# The rule above did not catch it because it is anchored to `/apps/mobile/`, and
# no gate objected because `.prettierignore` and ESLint are scoped the same way.
# `scripts/nativeBuildOutput.mjs`, run by `test:scripts`, is the gate that does.
/ios/
/android/

# Signing material and provisioning. Never commit.
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
google-services.json
GoogleService-Info.plist

# Firebase Admin service-account keys. Never commit.
**/serviceAccountKey.json
**/*-firebase-adminsdk-*.json

# Environment files. Only the *.example templates are tracked.
#
# The negations are not decoration. `.env.*` matches `.env.local.example` too,
# so without the second exception `apps/admin/.env.local.example` is silently
# excluded from the repository — which it was until Phase 12, meaning a fresh
# clone could not follow the documented setup step that copies it.
.env
.env.*
!.env.example
!.env.*.example

# Metro
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# TypeScript
*.tsbuildinfo

# Test / coverage output
coverage/

# Python (services/analytics)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Next.js (apps/admin)
.next/
out/

# Cloud Functions (functions/). `lib/` is the tsc emit — regenerate, never commit.
functions/lib/
# Local values for `defineSecret` params, read by the functions emulator.
# The real values live in Secret Manager. Never commit these.
**/.secret.local
.runtimeconfig.json

# Editors and OS
.DS_Store
*.pem
.idea/
*.swp

# Generated by `npm run emulators:lan` — firebase.json with every emulator bound
# to 0.0.0.0 so a physical device can reach it. Regenerated on every run.
.firebase-lan.json

# Firebase emulator persisted data (npm run emulators:persist)
.firebase-data/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
storage-debug.log
