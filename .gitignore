# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build output. Generated by `expo prebuild` — regenerate, never commit.
/apps/mobile/ios/
/apps/mobile/android/
.kotlin/
*.orig.*

# Signing material and provisioning. Never commit.
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
google-services.json
GoogleService-Info.plist

# Firebase Admin service-account keys. Never commit.
**/serviceAccountKey.json
**/*-firebase-adminsdk-*.json

# Environment files. Only .env.example is tracked.
.env
.env.*
!.env.example

# Metro
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# TypeScript
*.tsbuildinfo

# Test / coverage output
coverage/

# Python (services/analytics)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Next.js (apps/admin)
.next/
out/

# Editors and OS
.DS_Store
*.pem
.idea/
*.swp
